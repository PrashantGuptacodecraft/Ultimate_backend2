<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= pageTitle %> | Dirbnb</title>
  <link rel="stylesheet" href="/home.css">
</head>
<body>
  <header><a href="/" class="brand">Dirbnb</a><nav><a href="/">Explore</a><a href="/host/add-home">List your home</a></nav></header>
  <main class="form-wrap">
    <h1>List your home</h1><p>Share your place with travelers.</p>
    <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
    <form action="/host/add-home" method="post">
      <label for="homeName">Home name</label><input id="homeName" name="homeName" value="<%= form?.homeName ?? '' %>" maxlength="100" required>
      <label for="homeLocation">Location</label><input id="homeLocation" name="homeLocation" value="<%= form?.homeLocation ?? '' %>" maxlength="150" required>
      <label for="homePrice">Price per night</label><input id="homePrice" name="homePrice" type="number" min="0.01" step="0.01" value="<%= form?.homePrice ?? '' %>" required>
      <label for="rating">Rating (optional, 0 to 5)</label><input id="rating" name="rating" type="number" min="0" max="5" step="0.1" value="<%= form?.rating ?? '' %>">
      <label for="photoURL">Photo URL (optional)</label><input id="photoURL" name="photoURL" type="url" value="<%= form?.photoURL ?? '' %>">
      <button type="submit">Publish listing</button>
    </form>
  </main>
</body>
</html>
